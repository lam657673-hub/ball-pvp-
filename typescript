return { type, tier };
}
function mergeAll(inv: Record<string, number>): Record<string, number> {
let changed = true;
while (changed) {
changed = false;
TIERED_TYPES.forEach(type => {
for (let tier = 1; tier < MAX_TIER; tier++) {
const key = type + '_' + tier, nextKey = type + '_' + (tier + 1);
if ((inv[key] || 0) >= 2) {
inv[key] -= 2;
if (inv[key] <= 0) delete inv[key];
inv[nextKey] = (inv[nextKey] || 0) + 1;
changed = true;
}
}
});
}
return inv;
}
function rotRectPts(cx: number, cy: number, length: number, width: number, angleDeg: number) {
const a = Phaser.Math.DegToRad(angleDeg);
const dx = Math.cos(a), dy = Math.sin(a);
const nx = -dy, ny = dx;
const hl = length / 2, hw = width / 2;
return [
{ x: cx - dx * hl - nx * hw, y: cy - dy * hl - ny * hw },
{ x: cx + dx * hl - nx * hw, y: cy + dy * hl - ny * hw },
{ x: cx + dx * hl + nx * hw, y: cy + dy * hl + ny * hw },
{ x: cx - dx * hl + nx * hw, y: cy - dy * hl + ny * hw }
];
}
