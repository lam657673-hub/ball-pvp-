function getRoleHpBonus(baseHp: number): number { return Math.round(baseHp * 0.05); }
function getRoleIncomingMultiplier(entity: Entity): number {
if (entity.godMode) return 0;
if (entity.role === 'survivalist') return 0.92;
if (entity.role === 'admin') return ADMIN_INCOMING_MUL;
return 1;
}
function getRoleDmgMultiplier(entity: Entity): number {
if (entity.role === 'survivalist') {
const missingFrac = 1 - (entity.hp / entity.maxHp);
return 1 + Math.max(0, missingFrac * 1.5);
}
return 1;
}
function getRoleSpeedMultiplier(entity: Entity): number {
if (entity.role === 'survivalist') {
const missingFrac = 1 - (entity.hp / entity.maxHp);
return 1 - 0.4 * Math.max(0, missingFrac);
}
return 1;
}
function applyAdminCrit(entity: Entity, dmg: number): { dmg: number; isCrit: boolean } {
if (entity.role === 'admin' && Math.random() < ADMIN_CRIT_CHANCE) {
return { dmg: dmg * ADMIN_CRIT_MUL, isCrit: true };
}
