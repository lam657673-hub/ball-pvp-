}
function computeCooldown(entity: Entity): number {
let cd = entity.weapon.baseCooldown || 700;
if (entity.element) {
if (entity.element.type === 'fire') cd -= entity.element.tier * 30;
if (entity.element.type === 'lightning') cd -= entity.element.tier * 25;
}
cd *= getRoleSpeedMultiplier(entity);
if (entity.admin && entity.admin.speedActive) cd *= 0.5;
return Math.max(120, cd);
}
const TIERED_TYPES = ['fire', 'lightning', 'poison', 'glitch'];
