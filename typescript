}
});
function appendLog(msg: string, color = '#00ff88') {
if (!consoleLogs) return;
const div = document.createElement('div');
div.style.color = color;
div.textContent = msg;
consoleLogs.appendChild(div);
consoleLogs.scrollTop = consoleLogs.scrollHeight;
}
if (consoleInput) {
consoleInput.addEventListener('keydown', (e: KeyboardEvent) => {
if (e.key === 'Enter') {
const cmd = consoleInput.value.trim();
consoleInput.value = '';
if (!cmd) return;
appendLog('> ' + cmd, '#fff');
handleAdminCommand(cmd);
}
});
}
function handleAdminCommand(cmd: string) {
const parts = cmd.split(' ');
const c = parts[0].toLowerCase();
const scene = (window as any).currentGameScene;
switch (c) {
case '/help':
appendLog('=== SYSTEM COMMANDS ===');
appendLog('/god : Toggle Invincibility');
appendLog('/heal : Restore HP');
appendLog('/buff : Multiply Attack');
appendLog('/speed : Increase Frequency');
appendLog('/-cd : Reset Cooldown');
appendLog('/coins <amount> : Add Currency');
appendLog('/kill : Terminate Target');
appendLog('/clear : Clear Screen');
break;
case '/god':
if (scene && scene.p) {
scene.p.godMode = !scene.p.godMode;
appendLog(`[SYSTEM] God Mode: ${scene.p.godMode ? 'ACTIVE' : 'INACTIVE'}`);
}
break;
case '/heal':
if (scene && scene.p) {
scene.p.hp = scene.p.maxHp;
scene.updateBars();
appendLog('[SYSTEM] HP Restored.');
}
break;
case '/buff':
if (scene && scene.p) {
scene.p.admin = scene.p.admin || {};
scene.p.admin.buffActive = true;
appendLog('[SYSTEM] Attack Buff Activated.');
}
break;
case '/speed':
if (scene && scene.p) {
scene.p.admin = scene.p.admin || {};
scene.p.admin.speedActive = true;
appendLog('[SYSTEM] Speed Buff Activated.');
}
break;
case '/-cd':
if (scene && scene.p) {
scene.p.nextAtkAt = 0;
appendLog('[SYSTEM] Cooldown Cleared.');
}
break;
case '/kill':
if (scene && scene.e) {
scene.e.hp = 0;
scene.updateBars();
scene.checkEnd();
appendLog('[SYSTEM] Target Terminated.');
}
break;
case '/coins':
const amount = parseInt(parts[1]) || 1000;
const current = loadCoins();
saveCoins(current + amount);
appendLog(`[SYSTEM] Added +${amount} (Total: ${current + amount})`);
break;
case '/clear':
if (consoleLogs) consoleLogs.innerHTML = '';
break;
default:
appendLog(`[ERROR] Unknown command "${c}". Use /help.`, '#ff4444');
break;
}
}
