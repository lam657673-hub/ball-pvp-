const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV'];
const MAX_TIER = 15;
const rollPool: string[] = [];
['fire', 'lightning', 'poison'].forEach(t => [1, 2, 3, 4].forEach(tier => rollPool.push(t + '_' + tier)));
rollPool.push('shadow_1', 'plant_1');
