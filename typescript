const consoleDiv = document.getElementById('admin-console') as HTMLElement;
const consoleLogs = document.getElementById('console-logs') as HTMLElement;
const consoleInput = document.getElementById('console-input') as HTMLInputElement;
const adminToggleBtn = document.getElementById('admin-toggle-btn') as HTMLElement;
function toggleConsole() {
const isShow = consoleDiv.style.display === 'flex';
consoleDiv.style.display = isShow ? 'none' : 'flex';
if (!isShow && consoleInput) consoleInput.focus();
}
if (adminToggleBtn) adminToggleBtn.addEventListener('click', toggleConsole);
window.addEventListener('keydown', (e: KeyboardEvent) => {
if (e.key === '`' || e.key === '~') {
