const NORMAL_KEYS = ['kiem', 'riu', 'khien', 'cung', 'no', 'giao', 'railgun', 'songquyen'];
function randWeapon(): WeaponDef { return weaponDefs[NORMAL_KEYS[Math.floor(Math.random() * NORMAL_KEYS.length)]]; }
function dealDamage(attacker: WeaponDef, defender: WeaponDef | null, baseDmg: number): number {
let dmg = baseDmg;
if (defender && defender.blockReduction) {
let reduction = defender.blockReduction;
if (attacker.shieldPierce) reduction *= (1 - attacker.shieldPierce);
dmg *= (1 - reduction);
}
return dmg;
}
function lightningBoltDmg(tier: number): number { return 6 + (tier * 5); }
function getDmgMultiplier(maxHp: number): number { return maxHp <= 500 ? 1 : Math.sqrt(maxHp / 500); }
